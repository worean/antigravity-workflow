# ==============================================================================
# AntiGravity Workflow Server Environment Variables (.env.example)
# ==============================================================================

# ------------------------------------------------------------------------------
# 1. Server & Network Configurations
# ------------------------------------------------------------------------------
# 서버가 바인딩할 포트 번호 (기본값: 4000)
PORT=4000

# HTTPS 활성화 여부 (true/false, certs/key.pem 및 certs/cert.pem 필요)
USE_HTTPS=true
ENABLE_HTTPS=true

# 프론트엔드 웹 클라이언트 기본 URL (CORS 및 인증 메일 링크에 활용)
CLIENT_BASE_URL=http://localhost:5173

# 런타임 환경 (development, production, test)
NODE_ENV=development


# ------------------------------------------------------------------------------
# 2. Database Configurations (Dual PostgreSQL Architecture)
# ------------------------------------------------------------------------------
# 시스템 공통 DB (사용자 계정, 워크스페이스 메타데이터, 인증 정보 등)
GLOBAL_DATABASE_URL=postgresql://juyeong:qkrwndud@localhost:5432/global?schema=public

# 워크스페이스 전용 DB (프로젝트, 이슈, 스프린트, 코멘트, 첨부파일 등)
WORKSPACE_DATABASE_URL=postgresql://juyeong:qkrwndud@localhost:5432/workspace?schema=public

# 태스크 스토리지 모드 (postgresql 또는 sqlite, 기본값: postgresql)
TASK_STORAGE_MODE=postgresql

# Fallback 단일 DB URL (테스트 환경 또는 구버전 단일 DB 호환용)
DATABASE_URL=postgresql://juyeong:qkrwndud@localhost:5432/workspace?schema=public


# ------------------------------------------------------------------------------
# 3. Workspace Configurations
# ------------------------------------------------------------------------------
# 서버 최초 구동 시 자동 생성 및 동기화할 기본 워크스페이스 이름
DEFAULT_WORKSPACE_NAME=AntiGravity


# ------------------------------------------------------------------------------
# 4. Authentication & Security (JWT)
# ------------------------------------------------------------------------------
# JWT Access Token 암호화 및 검증용 비밀키 (운영 환경에서는 강력한 랜덤 문자열 필수 권장)
JWT_SECRET=antigravity-jwt-secret-key-2026


# ------------------------------------------------------------------------------
# 5. Social Login (Google OAuth 2.0 - 선택 사항)
# ------------------------------------------------------------------------------
# Google Cloud Console에서 발급받은 OAuth 클라이언트 ID 및 Secret
GOOGLE_CLIENT_ID=your-google-client-id.apps.googleusercontent.com
GOOGLE_CLIENT_SECRET=your-google-client-secret
GOOGLE_REDIRECT_URI=http://localhost:4000/api/auth/google/callback


# ------------------------------------------------------------------------------
# 6. Email Service (SMTP - 선택 사항)
# ------------------------------------------------------------------------------
# 이메일 인증, 매직 링크, 비밀번호 재설정 발송용 SMTP 서버 설정
# 미설정 시 개발 환경에서는 콘솔 로그(STDOUT)로 인증 링크가 출력됩니다.
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM="AntiGravity Workflow" <noreply@antigravity.internal>
