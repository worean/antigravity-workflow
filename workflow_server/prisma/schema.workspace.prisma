// ==========================================
// 🏢 Workspace Database Schema (schema.workspace.prisma)
// ==========================================

generator client {
  provider = "prisma-client-js"
  output   = "../src/generated/workspace-client"
}

datasource db {
  provider = "sqlite"
  url      = env("WORKSPACE_DATABASE_URL")
}

// 이슈 관련 메타데이터
model IssueType {
  id          Int     @id @default(autoincrement())
  name        String  @unique
  description String?
  icon        String?
  isSystem    Boolean @default(false)
  issues      Issue[]
}

model IssuePriority {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  level    Int     @default(0)
  color    String?
  isSystem Boolean @default(false)
  issues   Issue[]
}

model IssueStatus {
  id       Int     @id @default(autoincrement())
  name     String  @unique
  category String  @default("TODO")
  isSystem Boolean @default(false)
  issues   Issue[]
}

// 프로젝트 관련 메타데이터
model ProjectPriority {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  level    Int       @default(0)
  color    String?
  isSystem Boolean   @default(false)
  projects Project[]
}

model ProjectStatus {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  category String    @default("TODO")
  isSystem Boolean   @default(false)
  projects Project[]
}

// 마일스톤 관련 메타데이터
model MilestonePriority {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  level      Int         @default(0)
  color      String?
  isSystem   Boolean     @default(false)
  milestones Milestone[]
}

model MilestoneStatus {
  id         Int         @id @default(autoincrement())
  name       String      @unique
  category   String      @default("TODO")
  isSystem   Boolean     @default(false)
  milestones Milestone[]
}

// 테스트 관련 메타데이터
model TestRunStatus {
  id       Int       @id @default(autoincrement())
  name     String    @unique
  category String    @default("TODO")
  isSystem Boolean   @default(false)
  testRuns TestRun[]
}

model TestResultStatus {
  id          Int          @id @default(autoincrement())
  name        String       @unique
  category    String       @default("PASS")
  isSystem    Boolean      @default(false)
  testResults TestResult[]
}

model TestStepType {
  id       Int        @id @default(autoincrement())
  name     String     @unique // SETUP, PROCEDURE, TEARDOWN
  isSystem Boolean    @default(false)
  steps    TestStep[]
}

// 워크스페이스 내 유저 모델 (Global User 미러/캐시 및 로컬 호환)
model User {
  id          Int      @id @default(autoincrement())
  email       String   @unique
  name        String?
  password    String?
  role        String   @default("MEMBER")
  avatar      String?
  avatarColor String?
  pushToken   String?
  preferences String?  @default("{}")

  socialAccounts   SocialAccount[]

  issues           Issue[]           @relation("AuthorIssues")
  assigned         Issue[]           @relation("AssigneeIssues")
  comments         Comment[]
  projects         Project[]         @relation("ProjectOwner")
  memberships      ProjectMember[]
  groupMemberships GroupMember[]
  testRuns         TestRun[]         @relation("TestExecutor")
  notifications    Notification[]
  attachments      Attachment[]
  histories        IssueHistory[]
  revisions        IssueRevision[]
  worklogs         Worklog[]
  mentions         CommentMention[]
  reactions        CommentReaction[]
  watchedIssues    IssueWatcher[]
  likes            IssueLike[]

  chatMembers      ChatMember[]
  chatMessages     ChatMessage[]
  chatReactions    ChatMessageReaction[]

  favorites        Favorite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model SocialAccount {
  id           Int       @id @default(autoincrement())
  provider     String    @default("GOOGLE")
  providerId   String
  email        String?
  accessToken  String?
  refreshToken String?
  tokenExpiry  DateTime?

  userId       Int
  user         User      @relation(fields: [userId], references: [id], onDelete: Cascade)

  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  @@unique([provider, providerId])
}

// 프로젝트 관리
model Project {
  id          Int     @id @default(autoincrement())
  name        String
  description String?
  key         String  @unique

  ownerId Int
  owner   User @relation("ProjectOwner", fields: [ownerId], references: [id])

  statusId Int           @default(1)
  status   ProjectStatus @relation(fields: [statusId], references: [id], onDelete: SetDefault)

  priorityId Int             @default(1)
  priority   ProjectPriority @relation(fields: [priorityId], references: [id], onDelete: SetDefault)

  plannedStartDate DateTime?
  dueDate          DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?

  syncStatus String @default("SYNCED")

  members         ProjectMember[]
  groups          ProjectGroup[]
  sprints         Sprint[]
  issues          Issue[]
  milestones      Milestone[]
  testSuites      TestSuite[]
  testCases       TestCase[]
  testRuns        TestRun[]
  customFieldDefs CustomFieldDefinition[]
  chatChannels    ChatChannel[]
  tags            Tag[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 프로젝트 멤버 및 권한 (RBAC - Individual)
model ProjectMember {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // ADMIN, MEMBER, VIEWER
  createdAt DateTime @default(now())

  @@unique([projectId, userId])
}

// 프로젝트 참여 그룹 및 권한 (RBAC - Group)
model ProjectGroup {
  id        Int      @id @default(autoincrement())
  projectId Int
  project   Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  groupId   Int
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER") // ADMIN, MEMBER, VIEWER
  createdAt DateTime @default(now())

  @@unique([projectId, groupId])
}

// 마일스톤 관리
model Milestone {
  id          Int     @id @default(autoincrement())
  title       String
  description String?

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  statusId Int             @default(1)
  status   MilestoneStatus @relation(fields: [statusId], references: [id], onDelete: SetDefault)

  priorityId Int               @default(1)
  priority   MilestonePriority @relation(fields: [priorityId], references: [id], onDelete: SetDefault)

  plannedStartDate DateTime?
  dueDate          DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?

  syncStatus String @default("SYNCED")

  issues    Issue[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 아자일 스프린트 관리
model Sprint {
  id        Int       @id @default(autoincrement())
  name      String
  goal      String?
  notes     String?   // 스프린트 회의록, 데일리 스크럼 메모, 의사결정 노트 (Markdown 지원)
  startDate DateTime?
  endDate   DateTime?
  status    String    @default("PLANNED") // PLANNED, ACTIVE, COMPLETED

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  issues    Issue[]
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 통합 일감/이슈 모델 (Task, Bug, Epic, Story 등)
model Issue {
  id          Int     @id @default(autoincrement())
  issueNumber Int?    // 프로젝트 내 순번 (예: PRJ-101의 101)
  title       String
  description String? // Markdown 형식 지원

  typeId Int       @default(1)
  type   IssueType @relation(fields: [typeId], references: [id], onDelete: SetDefault)

  priorityId Int           @default(1)
  priority   IssuePriority @relation(fields: [priorityId], references: [id], onDelete: SetDefault)

  statusId Int         @default(1)
  status   IssueStatus @relation(fields: [statusId], references: [id], onDelete: SetDefault)

  progress       Int    @default(0) // 진척도 (0 ~ 100%)
  estimatedHours Float?             // 추정 소요 시간
  loggedHours    Float? @default(0) // 실제 투입 시간 누적

  plannedStartDate DateTime?
  dueDate          DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?

  customFields String?

  parentId Int?
  parent   Issue?  @relation("IssueHierarchy", fields: [parentId], references: [id], onDelete: SetNull)
  children Issue[] @relation("IssueHierarchy")

  outboundLinks IssueLink[] @relation("SourceIssue")
  inboundLinks  IssueLink[] @relation("TargetIssue")

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  sprintId Int?
  sprint   Sprint? @relation(fields: [sprintId], references: [id], onDelete: SetNull)

  milestoneId Int?
  milestone   Milestone? @relation(fields: [milestoneId], references: [id], onDelete: SetNull)

  authorId Int
  author   User @relation("AuthorIssues", fields: [authorId], references: [id])

  assigneeId Int?
  assignee   User? @relation("AssigneeIssues", fields: [assigneeId], references: [id])

  labels        Label[]
  tags          Tag[]
  testCases     TestCase[]
  comments      Comment[]
  reminders     Reminder[]
  attachments   Attachment[]
  histories     IssueHistory[]
  revisions     IssueRevision[]
  watchers      IssueWatcher[]
  likes         IssueLike[]
  worklogs      Worklog[]
  calendarLinks IssueCalendarLink[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@unique([projectId, issueNumber])
}

// 태그 모델 (이슈 및 프로젝트 해시태그 분류 시스템)
model Tag {
  id        Int       @id @default(autoincrement())
  name      String    @unique
  color     String?   @default("#3b82f6")
  issues    Issue[]
  projects  Project[]
  createdAt DateTime  @default(now())
  updatedAt DateTime  @updatedAt
}

// 이슈 좋아요 (Like / Unlike)
model IssueLike {
  issueId   Int
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([issueId, userId])
}

// 이슈 간 연관 관계
model IssueLink {
  id            Int    @id @default(autoincrement())
  sourceIssueId Int
  sourceIssue   Issue  @relation("SourceIssue", fields: [sourceIssueId], references: [id], onDelete: Cascade)
  targetIssueId Int
  targetIssue   Issue  @relation("TargetIssue", fields: [targetIssueId], references: [id], onDelete: Cascade)
  type          String // BLOCKS, IS_BLOCKED_BY, RELATES_TO, DUPLICATES
}

// 커스텀 필드 정의 (메타데이터)
model CustomFieldDefinition {
  id           Int      @id @default(autoincrement())
  key          String   @unique
  name         String
  description  String?
  fieldType    String   @default("JSON") // STRING, NUMBER, DATE, SELECT, JSON 등
  schemaJson   String?  // validation 스키마 JSON string
  defaultValue String?
  isRequired   Boolean  @default(false)
  isGlobal     Boolean  @default(true)

  projectId Int?
  project   Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 마크다운 및 커뮤니케이션 댓글
model Comment {
  id         Int     @id @default(autoincrement())
  content    String  // Markdown 형식 지원
  isInternal Boolean @default(false)

  authorId Int
  author   User @relation(fields: [authorId], references: [id])
  issueId  Int
  issue    Issue @relation(fields: [issueId], references: [id], onDelete: Cascade)

  parentId Int?

  mentions    CommentMention[]
  reactions   CommentReaction[]
  attachments Attachment[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

// 댓글 내 언급 (@User Mention)
model CommentMention {
  id        Int      @id @default(autoincrement())
  commentId Int
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@unique([commentId, userId])
}

// 댓글 이모지 반응
model CommentReaction {
  id        Int      @id @default(autoincrement())
  commentId Int
  comment   Comment  @relation(fields: [commentId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String
  createdAt DateTime @default(now())

  @@unique([commentId, userId, emoji])
}

// 라벨
model Label {
  id     Int     @id @default(autoincrement())
  name   String  @unique
  color  String  @default("#000000")
  issues Issue[]
}

// 미디어 / 첨부파일
model Attachment {
  id           Int     @id @default(autoincrement())
  filename     String
  originalName String
  mimeType     String
  size         Int
  url          String
  thumbnailUrl String?
  mediaType    String  @default("FILE")
  width        Int?
  height       Int?
  duration     Int?

  issueId   Int?
  issue     Issue?   @relation(fields: [issueId], references: [id], onDelete: Cascade)
  commentId Int?
  comment   Comment? @relation(fields: [commentId], references: [id], onDelete: Cascade)

  uploaderId Int
  uploader   User     @relation(fields: [uploaderId], references: [id])
  createdAt  DateTime @default(now())
}

// 외부 미디어 링크 미리보기 캐싱
model LinkPreview {
  id          Int      @id @default(autoincrement())
  url         String   @unique
  title       String?
  description String?
  siteName    String?
  mediaType   String?
  imageUrl    String?
  embedHtml   String?
  fetchedAt   DateTime @default(now())
}

// 마크다운 본문 변경 이력
model IssueRevision {
  id          Int      @id @default(autoincrement())
  issueId     Int
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  authorId    Int
  author      User     @relation(fields: [authorId], references: [id])
  title       String
  description String?
  reason      String?
  createdAt   DateTime @default(now())
}

// 이슈 변경 감사 로그
model IssueHistory {
  id        Int      @id @default(autoincrement())
  issueId   Int
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id])
  field     String
  oldValue  String?
  newValue  String?
  createdAt DateTime @default(now())
}

// 이슈 관심 구독자
model IssueWatcher {
  issueId   Int
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime @default(now())

  @@id([issueId, userId])
}

// 작업 시간 기록 (Worklog)
model Worklog {
  id          Int      @id @default(autoincrement())
  issueId     Int
  issue       Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  userId      Int
  user        User     @relation(fields: [userId], references: [id])
  timeSpent   Int      // 분 단위
  startedAt   DateTime @default(now())
  description String?
  createdAt   DateTime @default(now())
}

// 알림 시스템
model Notification {
  id        Int       @id @default(autoincrement())
  userId    Int
  user      User      @relation(fields: [userId], references: [id])
  title     String
  content   String
  type      String
  link      String?
  readAt    DateTime?
  createdAt DateTime  @default(now())
}

// 미리알림 (Reminder)
model Reminder {
  id        Int      @id @default(autoincrement())
  issueId   Int
  issue     Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  remindAt  DateTime
  isSent    Boolean  @default(false)
  createdAt DateTime @default(now())
}

// QA / 테스트 관리 시스템
model TestSuite {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  testCases TestCase[]
  testRuns  TestRunTestSuite[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestCase {
  id          Int     @id @default(autoincrement())
  title       String
  description String?

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  testSuiteId Int?
  testSuite   TestSuite? @relation(fields: [testSuiteId], references: [id])

  steps    TestStep[]
  testRuns TestRunTestCase[]
  results  TestResult[]
  issues   Issue[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestStep {
  id         Int      @id @default(autoincrement())
  testCaseId Int
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  typeId Int
  type   TestStepType @relation(fields: [typeId], references: [id])

  stepOrder      Int
  description    String
  expectedResult String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestRun {
  id          Int     @id @default(autoincrement())
  name        String
  description String?

  projectId Int
  project   Project @relation(fields: [projectId], references: [id], onDelete: Cascade)

  statusId Int           @default(1)
  status   TestRunStatus @relation(fields: [statusId], references: [id], onDelete: SetDefault)

  executorId Int
  executor   User @relation("TestExecutor", fields: [executorId], references: [id])

  testSuites TestRunTestSuite[]
  testCases  TestRunTestCase[]
  results    TestResult[]

  plannedStartDate DateTime?
  plannedEndDate   DateTime?
  actualStartDate  DateTime?
  actualEndDate    DateTime?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model TestRunTestSuite {
  testRunId   Int
  testRun     TestRun   @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testSuiteId Int
  testSuite   TestSuite @relation(fields: [testSuiteId], references: [id], onDelete: Cascade)

  @@id([testRunId, testSuiteId])
}

model TestRunTestCase {
  testRunId      Int
  testRun        TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCaseId     Int
  testCase       TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)
  executionOrder Int      @default(0)

  @@id([testRunId, testCaseId])
}

model TestResult {
  id         Int      @id @default(autoincrement())
  testRunId  Int
  testRun    TestRun  @relation(fields: [testRunId], references: [id], onDelete: Cascade)
  testCaseId Int
  testCase   TestCase @relation(fields: [testCaseId], references: [id], onDelete: Cascade)

  statusId Int              @default(1)
  status   TestResultStatus @relation(fields: [statusId], references: [id], onDelete: SetDefault)

  actualResult String?
  errorMessage String?
  artifacts    String?

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

model IssueCalendarLink {
  id            Int      @id @default(autoincrement())
  issueId       Int
  issue         Issue    @relation(fields: [issueId], references: [id], onDelete: Cascade)
  calendarId    String
  googleEventId String   @unique
  syncStatus    String   @default("SYNCED")
  lastSyncedAt  DateTime @default(now())
  createdAt     DateTime @default(now())
  updatedAt     DateTime @updatedAt
}

model ActivityLog {
  id         Int      @id @default(autoincrement())
  action     String
  entityType String
  entityId   Int?
  userId     Int?
  userName   String?
  userEmail  String?
  summary    String?
  details    String?
  ipAddress  String?
  createdAt  DateTime @default(now())

  @@index([entityType, entityId])
  @@index([userId])
  @@index([createdAt])
}

model Group {
  id          Int      @id @default(autoincrement())
  name        String
  code        String?  @unique
  description String?
  order       Int      @default(0)

  parentId    Int?
  parent      Group?   @relation("GroupHierarchy", fields: [parentId], references: [id], onDelete: Cascade)
  children    Group[]  @relation("GroupHierarchy")

  members       GroupMember[]
  projectGroups ProjectGroup[]
  chatChannels  ChatChannel[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt
}

model GroupMember {
  id        Int      @id @default(autoincrement())
  groupId   Int
  group     Group    @relation(fields: [groupId], references: [id], onDelete: Cascade)
  userId    Int
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  role      String   @default("MEMBER")
  title     String?
  joinedAt  DateTime @default(now())

  @@unique([groupId, userId])
}

// 💬 Chat System Models
model ChatChannel {
  id          Int      @id @default(autoincrement())
  name        String
  type        String   @default("GLOBAL") // GLOBAL, PROJECT, GROUP, DM
  topic       String?
  icon        String?
  isPrivate   Boolean  @default(false)

  projectId   Int?
  project     Project? @relation(fields: [projectId], references: [id], onDelete: Cascade)

  groupId     Int?
  group       Group?   @relation(fields: [groupId], references: [id], onDelete: Cascade)

  members     ChatMember[]
  messages    ChatMessage[]

  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@index([type])
  @@index([projectId])
  @@index([groupId])
}

model ChatMember {
  id                 Int         @id @default(autoincrement())
  channelId          Int
  channel            ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  userId             Int
  user               User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  role               String      @default("MEMBER")
  notificationLevel  String      @default("ALL")
  mutedUntil         DateTime?
  lastNotificationAt DateTime?
  lastReadAt         DateTime    @default(now())

  createdAt          DateTime    @default(now())
  updatedAt          DateTime    @updatedAt

  @@unique([channelId, userId])
  @@index([userId])
  @@index([channelId])
}

model ChatMessage {
  id          Int         @id @default(autoincrement())
  channelId   Int
  channel     ChatChannel @relation(fields: [channelId], references: [id], onDelete: Cascade)
  senderId    Int
  sender      User        @relation(fields: [senderId], references: [id], onDelete: Cascade)
  content     String
  attachments String?
  mentions    String?
  hasMention  Boolean     @default(false)
  isPinned    Boolean     @default(false)
  isSystem    Boolean     @default(false)
  reactions   ChatMessageReaction[]

  createdAt   DateTime    @default(now())
  updatedAt   DateTime    @updatedAt

  @@index([channelId, createdAt])
  @@index([senderId])
}

model ChatMessageReaction {
  id        Int         @id @default(autoincrement())
  messageId Int
  message   ChatMessage @relation(fields: [messageId], references: [id], onDelete: Cascade)
  userId    Int
  user      User        @relation(fields: [userId], references: [id], onDelete: Cascade)
  emoji     String

  createdAt DateTime    @default(now())

  @@unique([messageId, userId, emoji])
  @@index([messageId])
}

// 즐겨찾기
model Favorite {
  id         Int      @id @default(autoincrement())
  userId     Int
  user       User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  targetType String   // PROJECT, ISSUE, SPRINT, CHAT_CHANNEL
  targetId   Int
  createdAt  DateTime @default(now())

  @@unique([userId, targetType, targetId])
  @@index([userId, targetType])
  @@index([targetType, targetId])
}
