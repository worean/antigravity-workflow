{
  "name": "antigravity-workflow-backend",
  "version": "1.1.0",
  "description": "Issue and Task Management System REST API Backend with Express and Prisma",
  "main": "dist/server.js",
  "scripts": {
    "dev": "tsx watch src/server.ts",
    "build": "npm run prisma:generate && tsc",
    "start": "node dist/server.js",
    "test": "vitest run",
    "prisma:generate": "prisma generate --schema=prisma/schema.global.prisma && prisma generate --schema=prisma/schema.workspace.prisma",
    "prisma:push:global": "prisma db push --schema=prisma/schema.global.prisma --accept-data-loss",
    "prisma:push:workspace": "prisma db push --schema=prisma/schema.workspace.prisma --accept-data-loss",
    "kill-port": "powershell -Command \"Get-NetTCPConnection -LocalPort 4000 -ErrorAction SilentlyContinue | ForEach-Object { Stop-Process -Id $_.OwningProcess -Force -ErrorAction SilentlyContinue }\""
  },
  "dependencies": {
    "@prisma/client": "^5.22.0",
    "bcryptjs": "^3.0.3",
    "cors": "^2.8.5",
    "dotenv": "^16.4.5",
    "express": "^4.19.2",
    "jsonwebtoken": "^9.0.3",
    "nodemailer": "^9.1.0",
    "socket.io": "^4.8.3"
  },
  "devDependencies": {
    "@types/bcryptjs": "^2.4.6",
    "@types/cors": "^2.8.17",
    "@types/express": "^4.17.21",
    "@types/jsonwebtoken": "^9.0.10",
    "@types/node": "^20.12.7",
    "@types/nodemailer": "^8.0.1",
    "@types/supertest": "^6.0.2",
    "prisma": "^5.22.0",
    "supertest": "^7.0.0",
    "tsx": "^4.7.2",
    "typescript": "^5.4.5",
    "vitest": "^1.6.0"
  },
  "imports": {
    "#lib/*": "./src/lib/*.js",
    "#modules/*": "./src/modules/*.js"
  }
}
