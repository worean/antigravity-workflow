# ==============================================================================
# 🧪 AntiGravity Workflow - Test Environment Example (.env.test.example)
# ==============================================================================
# 로컬 테스트 실행 시 복사하여 .env.test 로 사용합니다:
# cp .env.test.example .env.test

NODE_ENV=test
PORT=4001

# ------------------------------------------------------------------------------
# Test Database Configurations (Isolated PostgreSQL Test Databases)
# ------------------------------------------------------------------------------
# 개발/운영 DB를 보호하기 위해 반드시 _test 데이터베이스를 사용해야 합니다.
GLOBAL_DATABASE_URL="postgresql://user:password@localhost:5432/global_test"
WORKSPACE_DATABASE_URL="postgresql://user:password@localhost:5432/workspace_test"
DATABASE_URL="postgresql://user:password@localhost:5432/workspace_test"
TASK_STORAGE_MODE=postgresql

# ------------------------------------------------------------------------------
# Security & JWT
# ------------------------------------------------------------------------------
JWT_SECRET="antigravity-test-jwt-secret-key-2026"
JWT_EXPIRES_IN="7d"

# ------------------------------------------------------------------------------
# Test Workspace
# ------------------------------------------------------------------------------
DEFAULT_WORKSPACE_NAME="AntiGravity Test Workspace"

# ------------------------------------------------------------------------------
# AI & LLM Service (Mock for Tests)
# ------------------------------------------------------------------------------
OPENAI_API_KEY="test-mock-api-key"
OPENAI_BASE_URL="https://api.openai.com/v1"
OPENAI_MODEL="gpt-4o-mini"
